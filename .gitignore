# Secrets — never commit
.env
.env.local
*.pem
*.key
secrets/

# Dotfile backups created by --force
*.bak

# Logs (e.g. planned ~/.local/logs mirror)
logs/
*.log

# Python bytecode (python3 is used for YAML parsing)
__pycache__/
*.pyc

# Editor / OS cruft
*.swp
*.swo
*~
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Claude Code
.claude/worktrees/
.claude/settings.local.json
