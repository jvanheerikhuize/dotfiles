{
  "$schema": "https://claude.ai/schemas/claude-settings.json",
  "version": "1.0",
  "project": {
    "name": "dotfiles provisioner",
    "description": "Bash-driven Ubuntu 22.04 Stage 2 provisioner: packages, dotfiles, git identity, SSH key setup"
  },
  "preferences": {
    "codeStyle": {
      "preferExistingPatterns": true,
      "avoidOverEngineering": true,
      "followProjectConventions": true
    },
    "testing": {
      "requireTests": true,
      "testLocation": "colocated",
      "coverageThreshold": 80
    },
    "documentation": {
      "updateOnChange": true,
      "inlineComments": "minimal",
      "requireJsdoc": false
    }
  },
  "specProcessing": {
    "validateBeforeImplement": true,
    "createFeatureBranch": true,
    "branchNamingPattern": "feat/{spec-id}-*",
    "commitMessagePattern": "feat({spec-id}): {title}",
    "requireAllAcceptanceCriteria": true
  },
  "ignorePaths": [
    "node_modules",
    "dist",
    "build",
    ".git",
    "coverage",
    "*.log",
    ".env*"
  ],
  "contextFiles": [
    ".ai/CONTEXT.md",
    ".ai/architecture/PATTERNS.md",
    "README.md",
    "specs.config.yaml",
    "CONTRIBUTING.md"
  ],
  "permissions": {
    "allow": [
      "Bash(git commit:*)"
    ]
  }
}
